# Copier vers backend/.env pour le développement local. AUCUNE valeur ici
# n'est un secret réel (GATE secret, section 5.3) - ce fichier est commité
# volontairement pour documenter les variables attendues par environnement
# (section 17.1 - livrable "Config").

RESERVEFLASH_ENVIRONMENT=development

# Sélection de provider (section 5.3) - "mock" ne nécessite aucune clé.
RESERVEFLASH_AI_PROVIDER=mock
RESERVEFLASH_STORAGE_PROVIDER=mock
RESERVEFLASH_AUTH_PROVIDER=mock

# Requis uniquement quand AI_PROVIDER=openai (non implémenté en R0, voir
# app/infrastructure/ai/__init__.py). Ne JAMAIS committer une vraie clé.
# RESERVEFLASH_OPENAI_API_KEY=

# Requis uniquement quand STORAGE_PROVIDER=supabase ou AUTH_PROVIDER=supabase.
# RESERVEFLASH_SUPABASE_URL=
# RESERVEFLASH_SUPABASE_SERVICE_ROLE_KEY=

RESERVEFLASH_STORAGE_BUCKET=reserveflash-evidence

# Secret de signature JWT si un provider auth "maison" est un jour utilisé
# (non requis en mode mock, non requis avec Supabase Auth qui gère ses
# propres clés).
# RESERVEFLASH_JWT_SECRET=

# Développement local uniquement - mot de passe non sensible, jamais utilisé
# en production (voir infra/docker/docker-compose.yml et alembic.ini).
RESERVEFLASH_DATABASE_URL=postgresql+psycopg://reserveflash:reserveflash@localhost:5432/reserveflash

RESERVEFLASH_RESERVE_TEMPLATE_VERSION=fr_v1
RESERVEFLASH_PROMPT_VERSION=extraction_fr_v1
RESERVEFLASH_SCHEMA_VERSION_CONFIRMED=confirmed_fact_set.v1
RESERVEFLASH_SCHEMA_VERSION_CANDIDATE=candidate_fact_set.v1

RESERVEFLASH_SIGNED_URL_TTL_SECONDS=300

# R0.2 : /v1/incidents/* (CRUD complet, chemin optionnel/futur - voir
# docs/adr/0002-local-first-pivot.md) N'EST PAS monté par défaut. Ne PAS
# activer en déploiement V1 - réservé au développement/test du chemin cloud
# futur.
# RESERVEFLASH_ENABLE_LEGACY_CLOUD_INCIDENT_API=false
